# Cloudflare Workers 配置文件示例
# 复制此文件为 wrangler.toml 并修改配置

name = "video-parser-worker"
main = "cloudflare_worker_parser.js"
compatibility_date = "2024-01-01"

# 环境变量（存储默认参数）
[vars]
DEFAULT_Z_PARAM = "b413af76b43b1a0abc231718862417e2"
DEFAULT_S1IG_PARAM = "11397"
DEFAULT_G_PARAM = ""

# KV存储配置（用于存储和更新z参数）
# 首先需要创建KV命名空间:
# wrangler kv:namespace create "Z_PARAMS_KV"
# wrangler kv:namespace create "Z_PARAMS_KV" --preview
#
# [[kv_namespaces]]
# binding = "Z_PARAMS_KV"
# id = "your-kv-namespace-id"
# preview_id = "your-preview-kv-namespace-id"

# 路由配置（可选，用于自定义域名）
# routes = [
#   { pattern = "api.yourdomain.com/api/*", zone_name = "yourdomain.com" }
# ]

# 环境配置（生产/预览）
# [env.production]
# vars = { ENVIRONMENT = "production" }
#
# [env.preview]
# vars = { ENVIRONMENT = "preview" }

